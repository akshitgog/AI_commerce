# Developer configuration lives in config/*.yaml.
# Copy config/local.example.yaml to config/local.yaml for local values and secrets.

# CI/deployment can set APP_CONFIG_FILE in the process environment to select a YAML overlay.
# APP_CONFIG_FILE=config/production.yaml

# Existing flat environment variables remain supported as higher-priority deployment overrides.

# Database
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
# DATABASE_URL=sqlite:///commerce_dev.db  # For local development

# LLM Configuration
# LLM_API_KEY=your-api-key-here
# FIREWORKS_API_KEY=fw_xxxxx  # Alternative: Fireworks AI key
# LLM_MODEL=gpt-5.4-mini
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1

# Storage Configuration
# STORAGE_PROVIDER=local  # local, s3, gcs, or unconfigured
# STORAGE_BUCKET=product-images
# STORAGE_PUBLIC_BASE_URL=  # Optional: CDN URL for public access

# AWS S3 Storage (only if STORAGE_PROVIDER=s3)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Google Cloud Storage (only if STORAGE_PROVIDER=gcs)
# GCP_CREDENTIALS_JSON={"type":"service_account",...}

# Supabase Storage (only if STORAGE_PROVIDER=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...  # Get from Supabase dashboard
# SUPABASE_ANON_KEY=eyJhbGc...  # Optional: for client-side usage

# Payment Provider (Razorpay)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=replace-in-secret-manager
# RAZORPAY_WEBHOOK_SECRET=replace-in-secret-manager

# Buyer Sessions
# BUYER_SESSIONS_SECRET=generate-random-secret
# BUYER_SESSIONS_ISSUER_KEY=generate-random-key
