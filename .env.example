# Developer configuration lives in config/*.yaml.
# Copy config/local.example.yaml to config/local.yaml for local values and secrets.

# CI/deployment can set APP_CONFIG_FILE in the process environment to select a YAML overlay.
# APP_CONFIG_FILE=config/production.yaml

# Existing flat environment variables remain supported as higher-priority deployment overrides.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
# LLM_MODEL=gpt-5.4-mini
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=replace-in-secret-manager
# RAZORPAY_WEBHOOK_SECRET=replace-in-secret-manager
