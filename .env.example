# Local-only defaults. Copy to .env and never commit real secrets.
APP_ENV=development
APP_NAME=AI Commerce Gateway
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_commerce_gateway
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_commerce_gateway_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# Object storage is configured behind StorageService. Milestone 0 provides the contract only.
STORAGE_PROVIDER=unconfigured
STORAGE_BUCKET=product-images
STORAGE_PUBLIC_BASE_URL=

# Razorpay Test Mode only. Never commit real secrets or use rzp_live_* keys in this project.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_TIMEOUT_SECONDS=10
RAZORPAY_CHECKOUT_NAME=AI Commerce Gateway
